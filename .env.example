# ==============================================================================
# Project Sentinel - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=sentinel_dev_secret_key_change_in_production_32bytes!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 15+)
POSTGRES_USER=sentinel_dev
POSTGRES_PASSWORD=sentinel_secure_pass
POSTGRES_DB=sentinel
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sentinel_dev:sentinel_secure_pass@db:5432/sentinel

# Redis Cache & Task Queue
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://cache:6379/0

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=/app/chroma_data
CHROMA_HOST=vector-db
CHROMA_PORT=8000

# LLM & AI Engine Configuration
# For local host Ollama on Windows/Mac, use http://host.docker.internal:11434
# For a containerized Ollama service, use http://ollama:11434
OLLAMA_HOST=http://host.docker.internal:11434
PRIMARY_LLM_MODEL=qwen2.5:latest
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Planner & Confidence Thresholds
MAX_PLANNING_CYCLES=15
CONFIDENCE_AUTO_COMPLETE_THRESHOLD=0.85
STAGNATION_CYCLE_LIMIT=3

# Frontend Ports & URLs
VITE_API_URL=http://localhost:8000
